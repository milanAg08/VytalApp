<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/trend_bg">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Header Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MySpace"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:textColor="@color/trend_text_primary"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AI Health Insight"
                        android:textSize="14sp"
                        android:textColor="@color/pastel_blue_dark"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/vytal_logo"
                    android:alpha="0.9" />
            </LinearLayout>

            <!-- Subtitle -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Describe your symptoms and get AI-powered health insights"
                android:textSize="14sp"
                android:textColor="@color/trend_text_secondary"
                android:layout_marginBottom="20dp"
                android:lineSpacingExtra="2dp" />

            <!-- Symptom Input Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="@color/white"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Input Label -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="How are you feeling today?"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/trend_text_primary"
                        android:layout_marginBottom="12dp" />

                    <!-- Symptom Chips -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Quick symptoms:"
                        android:textSize="12sp"
                        android:textColor="@color/trend_text_muted"
                        android:layout_marginBottom="8dp" />

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none"
                        android:layout_marginBottom="16dp">

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/symptomChipGroup"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:singleLine="true"
                            app:chipSpacingHorizontal="8dp" />
                    </HorizontalScrollView>

                    <!-- Large Text Input -->
                    <EditText
                        android:id="@+id/inputSymptoms"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="140dp"
                        android:gravity="top|start"
                        android:inputType="textMultiLine"
                        android:background="@drawable/bg_symptom_input"
                        android:padding="16dp"
                        android:textSize="15sp"
                        android:textColor="@color/trend_text_primary"
                        android:hint="Type your symptoms here...\n\nExample: I've been feeling tired lately, experiencing frequent thirst, and have blurry vision sometimes."
                        android:textColorHint="@color/trend_text_muted" />

                    <!-- Analyze Button -->
                    <Button
                        android:id="@+id/btnAnalyze"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="16dp"
                        android:text="Analyze Symptoms"
                        android:textAllCaps="false"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:backgroundTint="@color/pastel_blue_dark"
                        android:textColor="@color/white"
                        app:cornerRadius="16dp"
                        app:icon="@drawable/ic_trend_chart"
                        app:iconGravity="textStart"
                        app:iconPadding="8dp"
                        app:iconTint="@color/white" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Results Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/resultCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="@color/white"
                android:visibility="gone"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Results Header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">

                        <View
                            android:layout_width="4dp"
                            android:layout_height="24dp"
                            android:background="@color/pastel_blue_dark"
                            android:layout_marginEnd="12dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Analysis Results"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/trend_text_primary" />
                    </LinearLayout>

                    <!-- Top Prediction Card -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="@color/medical_chip_bg"
                        android:layout_marginBottom="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:padding="16dp">

                            <ImageView
                                android:id="@+id/conditionIcon"
                                android:layout_width="52dp"
                                android:layout_height="52dp"
                                android:src="@drawable/ic_health_heart"
                                android:layout_marginEnd="16dp" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/conditionName"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Condition Name"
                                    android:textSize="16sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/trend_text_primary" />

                                <TextView
                                    android:id="@+id/conditionSubtitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Detection Confidence"
                                    android:textSize="12sp"
                                    android:textColor="@color/trend_text_secondary"
                                    android:layout_marginTop="2dp" />

                                <!-- Confidence Bar -->
                                <FrameLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="6dp"
                                    android:layout_marginTop="8dp"
                                    android:background="@drawable/bg_confidence_bar">

                                    <View
                                        android:id="@+id/confidenceBarFill"
                                        android:layout_width="0dp"
                                        android:layout_height="match_parent"
                                        android:background="@drawable/bg_confidence_fill" />
                                </FrameLayout>
                            </LinearLayout>

                            <TextView
                                android:id="@+id/confidencePercentage"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="85%"
                                android:textSize="28sp"
                                android:textStyle="bold"
                                android:textColor="@color/confidence_high"
                                android:layout_marginStart="12dp" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- All Predictions List -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="All Predictions"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/trend_text_secondary"
                        android:layout_marginBottom="12dp" />

                    <LinearLayout
                        android:id="@+id/predictionsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <!-- Result Info -->
                    <TextView
                        android:id="@+id/resultInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:padding="12dp"
                        android:background="@drawable/bg_info_box"
                        android:text="Note: This is for informational purposes only."
                        android:textSize="12sp"
                        android:textColor="@color/trend_text_secondary"
                        android:lineSpacingExtra="2dp" />

                    <!-- Go to Analyzer Button -->
                    <Button
                        android:id="@+id/btnGoToAnalyzer"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="16dp"
                        android:text="Open Disease Analyzer"
                        android:textAllCaps="false"
                        android:textSize="14sp"
                        android:backgroundTint="@color/colorPrimary"
                        android:textColor="@color/white"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/ic_arrow_right"
                        app:iconGravity="end"
                        app:iconTint="@color/white" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Legacy output (hidden) -->
            <TextView
                android:id="@+id/outputResult"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        </LinearLayout>
    </ScrollView>

    <!-- Persistent Bottom Button -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="0dp"
        app:cardElevation="16dp"
        app:cardBackgroundColor="@color/white">

        <Button
            android:id="@+id/btnOpenDiseaseAnalyzers"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_margin="12dp"
            android:text="Open Disease Analyzers"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="@color/buttonGreenDark"
            android:textColor="@color/white"
            app:cornerRadius="16dp"
            app:icon="@drawable/ic_health_heart"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconTint="@color/white" />
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
