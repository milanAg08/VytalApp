<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/gradient_card"
    android:clipToOutline="true"
    android:elevation="8dp">

    <!-- Vytal logo watermark -->
    <ImageView
        android:id="@+id/logoWatermark"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_gravity="center"
        android:src="@drawable/vytal_logo"
        android:alpha="0.18"
        android:contentDescription="@string/app_name"
        android:layout_marginBottom="8dp" />

    <!-- Header -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Add Health Record"
        android:textColor="@android:color/white"
        android:textStyle="bold"
        android:textSize="20sp"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <!-- Systolic -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Systolic Pressure (mmHg)"
        android:layout_marginTop="4dp"
        app:boxStrokeColor="@color/vytal_teal"
        app:hintTextColor="@color/vytal_teal">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editSystolic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:textColor="@android:color/white" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Diastolic -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Diastolic Pressure (mmHg)"
        android:layout_marginTop="12dp"
        app:boxStrokeColor="@color/vytal_teal"
        app:hintTextColor="@color/vytal_teal">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editDiastolic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:textColor="@android:color/white" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Sugar Level -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Sugar Level (mg/dL)"
        android:layout_marginTop="12dp"
        app:boxStrokeColor="@color/vytal_teal"
        app:hintTextColor="@color/vytal_teal">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editSugarLevel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal"
            android:textColor="@android:color/white" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Weight -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Weight (kg)"
        android:layout_marginTop="12dp"
        app:boxStrokeColor="@color/vytal_teal"
        app:hintTextColor="@color/vytal_teal">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editWeight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal"
            android:textColor="@android:color/white" />
    </com.google.android.material.textfield.TextInputLayout>

</LinearLayout>
