<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0FDF4"
    tools:context=".ui.EventFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Beautiful Gradient Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/header_gradient_bg"
            android:paddingTop="16dp"
            android:paddingBottom="20dp">

            <!-- Top Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="20dp"
                android:layout_marginBottom="4dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/eventsHeader"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Events"
                        android:textStyle="bold"
                        android:textSize="26sp"
                        android:textColor="#FFFFFF"/>

                    <TextView
                        android:id="@+id/tvSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Track challenges and log your progress"
                        android:textSize="13sp"
                        android:textColor="#D1FAE5"/>
                </LinearLayout>

                <!-- Add Event Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddEventTop"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="+ Add"
                    android:textSize="12sp"
                    android:textAllCaps="false"
                    android:paddingHorizontal="12dp"
                    app:backgroundTint="#FFFFFF"
                    android:textColor="#10B981"
                    app:cornerRadius="18dp"
                    app:strokeWidth="0dp"
                    app:icon="@android:drawable/ic_input_add"
                    app:iconSize="16dp"
                    app:iconTint="#10B981"
                    app:iconPadding="4dp"
                    android:layout_marginEnd="8dp"/>

                <ImageButton
                    android:id="@+id/btnRefresh"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@android:drawable/ic_menu_rotate"
                    android:background="@drawable/circle_white_bg"
                    android:padding="8dp"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="Refresh"/>

                <TextView
                    android:id="@+id/tvEventCount"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:text="0"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:textColor="#059669"
                    android:background="@drawable/circle_white_bg"
                    android:gravity="center"/>
            </LinearLayout>

            <!-- Search Bar -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="14dp"
                app:cardCornerRadius="23dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#FFFFFF">

                <androidx.appcompat.widget.SearchView
                    android:id="@+id/searchViewEvents"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:queryHint="Search events..."
                    app:iconifiedByDefault="false"
                    app:searchHintIcon="@null"/>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Category Filter Chips -->
        <HorizontalScrollView
            android:id="@+id/scrollViewCategories"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:paddingVertical="10dp"
            android:background="#FFFFFF"
            android:elevation="2dp">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupCategories"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                app:singleSelection="true"
                app:selectionRequired="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌟 All"
                    android:checked="true"
                    app:chipBackgroundColor="@color/chip_bg_selector"
                    app:chipStrokeWidth="0dp"
                    android:textColor="@color/chip_text_selector"/>

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipYoga"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🧘 Yoga"
                    app:chipBackgroundColor="@color/chip_bg_selector"
                    app:chipStrokeWidth="0dp"
                    android:textColor="@color/chip_text_selector"/>

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFitness"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💪 Fitness"
                    app:chipBackgroundColor="@color/chip_bg_selector"
                    app:chipStrokeWidth="0dp"
                    android:textColor="@color/chip_text_selector"/>

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipDiet"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🥗 Diet"
                    app:chipBackgroundColor="@color/chip_bg_selector"
                    app:chipStrokeWidth="0dp"
                    android:textColor="@color/chip_text_selector"/>

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipWellness"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🧠 Wellness"
                    app:chipBackgroundColor="@color/chip_bg_selector"
                    app:chipStrokeWidth="0dp"
                    android:textColor="@color/chip_text_selector"/>

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipHealth"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="❤️ Health"
                    app:chipBackgroundColor="@color/chip_bg_selector"
                    app:chipStrokeWidth="0dp"
                    android:textColor="@color/chip_text_selector"/>

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipMyEvents"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📝 My Events"
                    app:chipBackgroundColor="@color/chip_bg_selector"
                    app:chipStrokeWidth="0dp"
                    android:textColor="@color/chip_text_selector"/>
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <!-- Stats Dashboard -->
        <HorizontalScrollView
            android:id="@+id/scrollViewStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:visibility="visible">

            <LinearLayout
                android:id="@+id/layoutStats"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp">

                <!-- Joined Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="95dp"
                    android:layout_height="85dp"
                    android:layout_marginEnd="10dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="#10B981">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="10dp">

                        <TextView
                            android:id="@+id/tvJoinedCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textStyle="bold"
                            android:textSize="26sp"
                            android:textColor="#FFFFFF"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Active"
                            android:textSize="11sp"
                            android:textColor="#D1FAE5"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Points Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="95dp"
                    android:layout_height="85dp"
                    android:layout_marginEnd="10dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="#3B82F6">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="10dp">

                        <TextView
                            android:id="@+id/tvTotalPoints"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textStyle="bold"
                            android:textSize="26sp"
                            android:textColor="#FFFFFF"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Points"
                            android:textSize="11sp"
                            android:textColor="#DBEAFE"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Streak Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="95dp"
                    android:layout_height="85dp"
                    android:layout_marginEnd="10dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="#F59E0B">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="10dp">

                        <TextView
                            android:id="@+id/tvActiveStreak"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textStyle="bold"
                            android:textSize="26sp"
                            android:textColor="#FFFFFF"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Streak 🔥"
                            android:textSize="11sp"
                            android:textColor="#FEF3C7"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- My Events Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="95dp"
                    android:layout_height="85dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="#8B5CF6">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="10dp">

                        <TextView
                            android:id="@+id/tvMyEventsCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textStyle="bold"
                            android:textSize="26sp"
                            android:textColor="#FFFFFF"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="My Events"
                            android:textSize="11sp"
                            android:textColor="#EDE9FE"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Progress Bar -->
        <ProgressBar
            android:id="@+id/progressBarEvents"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="32dp"
            android:visibility="gone"
            android:indeterminateTint="#10B981"/>

        <!-- Empty State -->
        <LinearLayout
            android:id="@+id/layoutEmptyState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎯"
                android:textSize="80sp"
                android:layout_marginBottom="20dp"/>

            <TextView
                android:id="@+id/tvEmptyStateTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No Events Yet"
                android:textStyle="bold"
                android:textSize="24sp"
                android:textColor="#111827"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tvEmptyState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Create your own event or load sample challenges!"
                android:textSize="15sp"
                android:textColor="#6B7280"
                android:gravity="center"
                android:layout_marginBottom="28dp"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnCreateSampleEvents"
                    android:layout_width="wrap_content"
                    android:layout_height="50dp"
                    android:text="Load Samples"
                    android:textColor="#10B981"
                    android:backgroundTint="#D1FAE5"
                    android:paddingHorizontal="24dp"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:layout_marginEnd="12dp"/>

                <Button
                    android:id="@+id/btnCreateFirstEvent"
                    android:layout_width="wrap_content"
                    android:layout_height="50dp"
                    android:text="+ Create Event"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#10B981"
                    android:paddingHorizontal="24dp"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Events List -->
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefreshLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerViewEvents"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="8dp"
                android:clipToPadding="false"
                android:paddingBottom="80dp"
                tools:listitem="@layout/item_event"/>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    </LinearLayout>

    <!-- Floating Action Button -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabAddEvent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="72dp"
        android:text="Add Event"
        android:textColor="#FFFFFF"
        android:textAllCaps="false"
        app:icon="@android:drawable/ic_input_add"
        app:iconTint="#FFFFFF"
        app:backgroundTint="#10B981"
        app:elevation="8dp"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
