<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#FFFFFF"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header: User info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <View
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_icon_diabetes"
                android:backgroundTint="#10B981"
                android:clipToOutline="true"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:id="@+id/tvUserName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="User Name"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:textColor="#111827"/>

                <TextView
                    android:id="@+id/tvTimestamp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2 hours ago"
                    android:textSize="12sp"
                    android:textColor="#6B7280"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Post Content -->
        <TextView
            android:id="@+id/tvPostTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Post Title"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="#111827"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvPostContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Post content goes here..."
            android:textSize="14sp"
            android:textColor="#374151"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="12dp"/>

        <!-- Actions: Like and Comment -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="8dp"
            android:paddingBottom="4dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLike"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="13sp"
                android:textAllCaps="false"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                app:icon="@android:drawable/btn_star_big_off"
                app:iconSize="18dp"
                app:iconTint="#6B7280"
                android:textColor="#6B7280"
                app:backgroundTint="#F3F4F6"
                app:cornerRadius="20dp"
                app:strokeWidth="0dp"/>

            <View
                android:layout_width="8dp"
                android:layout_height="0dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnComment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="13sp"
                android:textAllCaps="false"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                app:icon="@android:drawable/ic_menu_recent_history"
                app:iconSize="18dp"
                app:iconTint="#6B7280"
                android:textColor="#6B7280"
                app:backgroundTint="#F3F4F6"
                app:cornerRadius="20dp"
                app:strokeWidth="0dp"/>

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>

            <TextView
                android:id="@+id/tvExpandComments"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="View comments"
                android:textSize="12sp"
                android:textColor="#10B981"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true"/>
        </LinearLayout>

        <!-- Comments Section (Expandable) -->
        <LinearLayout
            android:id="@+id/layoutComments"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginTop="12dp"
            android:paddingTop="12dp"
            android:background="#F9FAFB"
            android:padding="12dp"
            android:paddingStart="8dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/commentsRecycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"/>

            <!-- Comment Input -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <EditText
                    android:id="@+id/etCommentInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Write a comment..."
                    android:padding="10dp"
                    android:background="@drawable/bg_symptom_input"
                    android:textSize="13sp"
                    android:textColorHint="#9CA3AF"
                    android:maxLines="3"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSubmitComment"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Post"
                    android:textSize="12sp"
                    android:textAllCaps="false"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    app:backgroundTint="#10B981"
                    android:textColor="#FFFFFF"
                    app:cornerRadius="8dp"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

