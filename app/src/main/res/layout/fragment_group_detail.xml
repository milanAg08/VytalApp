<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:paddingBottom="80dp">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- WebView for showing article - fixed height, scrolls internally -->
        <WebView
            android:id="@+id/groupWebView"
            android:layout_width="match_parent"
            android:layout_height="400dp"/>

        <!-- Comment section header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Comments &amp; Reviews"
            android:textSize="18sp"
            android:textStyle="bold"
            android:padding="16dp"
            android:paddingTop="20dp"
            android:background="?attr/colorSurface"/>

        <!-- Comment input -->
        <EditText
            android:id="@+id/commentInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:hint="Write your review..."
            android:padding="12dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_symptom_input"
            android:textColor="@color/trend_text_primary"
            android:textColorHint="@color/trend_text_muted"/>

        <!-- Submit comment -->
        <Button
            android:id="@+id/btnSubmitComment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:text="Submit Review"
            android:textAllCaps="false"
            android:backgroundTint="@color/buttonGreenDark"
            android:textColor="@color/white"
            android:paddingHorizontal="24dp"
            app:cornerRadius="12dp"/>

        <!-- List of comments -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/commentsRecycler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:paddingBottom="16dp"/>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
